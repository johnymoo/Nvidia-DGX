CODING_AGENT_TOOLCHAIN=/absolute/path/to/coding-agent-toolchain

# Anthropic-compatible endpoints. Never commit real private addresses or tokens.
CLAUDE_DS_BASE_URL=https://your-online-ds-endpoint.example
PRIVATE_DS_BASE_URL=http://127.0.0.1:8890
QWEN_LOCAL_BASE_URL=http://127.0.0.1:8004

# Optional trusted service lifecycle commands.
BENCHMARK_PREPARE_DEEPSEEK_CMD=
BENCHMARK_PREPARE_QWEN_CMD=
BENCHMARK_FINALIZE_CMD=

BENCHMARK_ARTIFACT_ROOT=./artifacts/runs
CLAUDE_PILOT_CACHE=./artifacts/cache
