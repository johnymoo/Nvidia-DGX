# Use the same project files on both DGX Spark nodes. Override node-specific
# values such as NODE_RANK, VLLM_HOST_IP, and HEADLESS on each node.
DSPARK_VLLM_IMAGE=your-patch4-vllm-image:tag
MODEL_ROOT=/path/to/models
CACHE_ROOT=/path/to/huggingface-cache
DSPARK_MODEL=/models/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-v4-flash-0731

VLLM_HOST_IP=192.0.2.10
NODE_RANK=0
HEADLESS=
MASTER_ADDR=192.0.2.10
MASTER_PORT=29510

NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA=replace-with-rdma-device
NCCL_SOCKET_IFNAME=replace-with-fabric-interface
NCCL_IB_GID_INDEX=3

VLLM_HOST=0.0.0.0
VLLM_PORT=8890
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.78
KV_CACHE_DTYPE=nvfp4_ds_mla
MTP_NUM_TOKENS=5
RESTART_POLICY=no
