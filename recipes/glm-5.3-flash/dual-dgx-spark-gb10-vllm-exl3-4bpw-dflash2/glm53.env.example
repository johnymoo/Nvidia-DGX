# GLM-5.3-Flash EXL3 dual-GB10 kit configuration template.
# Copy to .env next to the cloned upstream repository checkout
# (MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks) and fill in real values.
# No credentials or real host information belong in version control.

# --- nodes -------------------------------------------------------------
# Fabric (CX7 RoCE) addresses used as vLLM master addr and rsync target.
HEAD_IP=192.0.2.20
WORKER_IP=192.0.2.21
WORKER_USER=replace-with-worker-user
WORKER_HOME=/home/YOUR_USERNAME
WORKER_SSH=replace-with-worker-user@192.0.2.21

# Per-kit CX7 pins (discover with: ls /sys/class/infiniband + ip -br a).
# Both nodes of this kit used the f0 port; other kits may use f1 on the head.
HEAD_CX7_IF=replace-with-fabric-interface
WORKER_CX7_IF=replace-with-fabric-interface
HEAD_CX7_IB=replace-with-rdma-device
WORKER_CX7_IB=replace-with-rdma-device
# RoCE v2 GID index carrying each node's own fabric IP (verify per node).
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3

# --- serve -------------------------------------------------------------
# Head API port. On the reference kit 8888 was reserved by a host service,
# so the validation used 18888.
PORT=18888
MASTER_PORT=29521
TP=2
NNODES=2
QUANTIZATION=exl3
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3

MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2

# Measured safe envelope on this kit (119.63 GiB visible UMA):
# 300k/0.84 boots and serves; 500k/0.84 starves the KV pool; 450k/0.89
# host-OOMs during torch.compile. See BENCHMARK-RESULTS.md.
MAX_MODEL_LEN=300000
GPU_MEM_UTIL=0.84
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=7168
KV_CACHE_DTYPE=fp8
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1

EXL3_FAT_KERNEL=1
EXL3_FAT_GROUPED=1
ENFORCE_EAGER=0
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_BOOT_SHAPE_WARMUP=1
GLM53_MIXED_PREFILL_CHUNK=skip
GLM53_ADAPTIVE_K=off
GLM53_DENSE_FP8=off

ABLIT=0
USE_HOST_NCCL=0
NCCL_DEBUG=WARN
NCCL_CROSS_NIC=0
CG_ESTIMATE=1

# Local-only tag (no slash) so start.sh builds/serves the locally built
# image with the E2/E3 kernels instead of the older public GHCR tag.
IMAGE=glm53-flash-sm121:local

# --- window orchestration (scripts/window-step.sh) ----------------------
# Paths on the head for the DS reference service stopped during the window.
DS_STOP_SCRIPT=/opt/dspark-vision/stop-deepseek-v4-flash-dspark.sh
DS_START_SCRIPT=/opt/dspark-vision/start-deepseek-v4-flash-dspark.sh
DS_MODEL=deepseek-v4-flash-0731
# Optional: run hermes real-task legs from a separate bench host.
# Leave empty to drive those legs externally.
X570_SSH=
