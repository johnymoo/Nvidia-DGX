# GB10-DS kit (gb10/gb10-2, chriswang/admin) — GLM-5.3-Flash EXL3 validation
# Copied to head:~/glm53-eval/GLM-5.3-Flash-EXL3-2x-DGX-Sparks/.env by prep_remote.sh
# Kit facts (verified 2026-09-10):
#   CX7 fabric: head 192.168.192.181 / worker 192.168.192.198 on enp1s0f0np0 (rocep1s0f0)
#   GID index 3 = RoCE v2 with each node's own fabric IP on both ranks
#   head :8888 is held by local-portal port registry -> GLM API on 8890
#   500k ctx / util 0.84 = maintainer receipt pair that boots reliably on
#   memory-thin hosts (repo overnight 2026-09-06 A/B ran the full 8k-256k ladder there)

HEAD_IP=192.168.192.181
WORKER_IP=192.168.192.198
WORKER_USER=admin
WORKER_HOME=/home/admin
WORKER_SSH=admin@192.168.192.198

HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f0
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3

PORT=8890
MASTER_PORT=29521
TP=2
NNODES=2
QUANTIZATION=exl3
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3

MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2

# 450k/0.89: our GB10s expose ~116.7 GiB GPU-visible UMA (DS: 99,784 MiB at
# util 0.835), ~10 GiB less than the repo kit, so the 500k/0.84 receipt starved
# the KV pool (boot refused: 10.98 GiB needed). 450k needs 10.6 GiB; 0.89 gives
# a ~12.2 GiB pool (1.15x) while leaving ~10 GiB host headroom post-DS-stop.
MAX_MODEL_LEN=450000
GPU_MEM_UTIL=0.89
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=7168
KV_CACHE_DTYPE=fp8
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1

EXL3_FAT_KERNEL=1
EXL3_FAT_GROUPED=1
ENFORCE_EAGER=0
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_BOOT_SHAPE_WARMUP=1
GLM53_MIXED_PREFILL_CHUNK=skip
GLM53_ADAPTIVE_K=off
GLM53_DENSE_FP8=off
GLM53_SPINWAIT_MS=stock

ABLIT=0
USE_HOST_NCCL=0
NCCL_DEBUG=WARN
NCCL_CROSS_NIC=0
CG_ESTIMATE=1

# Local-only tag (no slash) so start.sh never GHCR-pulls; built on head from this checkout.
IMAGE=glm53-flash-sm121:local
