# DeepSeek-V4.1-Flash EXL3 dual-GB10 kit configuration template.
# Copy to .env next to the cloned upstream repository checkout
# (MiaAI-Lab/DeepSeek-v4.1-Flash-EXL3-2x-DGX-Sparks) and fill in real values.
# No credentials or real host information belong in version control.
#
# Values below reproduce the 2026-09-17 validation profile on a 119.63 GiB UMA
# pair (2x DGX Spark GB10). The upstream kit targets a ~121.7 GiB kit; this
# profile trims boot margin / KV pin accordingly.

# --- nodes -------------------------------------------------------------
# Fabric (CX7 RoCE) addresses used as vLLM master addr and rsync target.
HEAD_IP=192.0.2.20
WORKER_IP=192.0.2.21
WORKER_USER=replace-with-worker-user
WORKER_HOME=/home/YOUR_USERNAME
WORKER_SSH=replace-with-worker-user@192.0.2.21

# Per-kit CX7 pins (discover with: ls /sys/class/infiniband + ip -br a).
HEAD_CX7_IF=replace-with-fabric-interface
WORKER_CX7_IF=replace-with-fabric-interface
HEAD_CX7_IB=replace-with-rdma-device
WORKER_CX7_IB=replace-with-rdma-device
# RoCE v2 GID index carrying each node's own fabric IP (verify per node).
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3

# --- serve -------------------------------------------------------------
# Head API port. On the reference kit 8888 was reserved by a host service,
# so the validation used 18890.
PORT=18890
MASTER_PORT=29523
TP=2
NNODES=2
QUANTIZATION=exl3
SERVED_MODEL_NAME=DeepSeek-v4.1-Flash-EXL3

# Upstream defaults to nfs weight sharing (no worker-local copy). The
# reference kit pre-stages the trees on both hosts and boots with
# SKIP_SYNC=1 plus DSV41_TRUST_STAGED=1 (start.sh in this recipe's source
# kit carries a one-line patch for that bypass).
WEIGHT_SYNC=rsync

# --- context / memory (119.63 GiB UMA pair) ----------------------------
# 0.86 aborts under host memory pressure during large-image vision work;
# 0.84 matches the production DeepSeek profile and completed clean.
GPU_MEM_UTIL=0.84
MAX_MODEL_LEN=300000
DSV41_BOOT_MARGIN_GIB=12
KV_CACHE_MEMORY_BYTES=2147483648

# --- concurrency / prefill --------------------------------------------
# EXL3_TEMP_ROWS_FUSED must be >= MAX_NUM_SEQS * (MTP k + 1); k=3 here.
MAX_NUM_SEQS=4
EXL3_TEMP_ROWS_FUSED=16
MAX_NUM_BATCHED_TOKENS=1536
LONG_PREFILL_TOKEN_THRESHOLD=1280
