# Runtime identity. The build script creates this local image on gb10, then the
# sync script transfers the exact image to gb10-2.
DSPARK_VLLM_IMAGE=gb10-ds4-vllm:f277b3d-nvfp4
DSPARK_MODEL=/models/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# API and distributed rendezvous. Port 8890 is free on both hosts at the
# 2026-08-10 inventory and avoids gb10's existing 8004/8888 services.
VLLM_HOST=0.0.0.0
VLLM_PORT=8890
MASTER_PORT=29510

# Official 0731 mixed FP8/FP4 weights plus the validated DSpark/NVFP4-KV lane.
KV_CACHE_DTYPE=nvfp4_ds_mla
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.78
MTP_NUM_TOKENS=5

# Long-context TTFT mitigation (2026-08-24). A request whose remaining prefill
# exceeds LONG_PREFILL_TOKEN_THRESHOLD is capped at that many tokens per step,
# so ~2048 tokens of the 8192 step budget stay available each step and
# cache-hit or small requests are no longer head-of-line blocked for minutes
# behind a 400K+ cold prefill (measured cost: the cold prefill itself is a few
# percent slower). Memory-neutral: raising MAX_NUM_BATCHED_TOKENS to 16384
# grew profiled activations and left only 6.32 GiB KV (< the 7.3 GiB the
# frozen 1,048,576 context requires), so the step budget stays 8192. Do not
# set --max-num-partial-prefills on this fork: it is explicitly unsupported
# (arg_utils _check_feature_supported) and the V1 scheduler admits concurrent
# prefills purely by token budget anyway.
LONG_PREFILL_TOKEN_THRESHOLD=6144

# Offline serving from the bind-mounted local checkpoint.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# First matching ConnectX-7 port on both hosts. Confirm carrier after cabling.
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3
NCCL_DEBUG=WARN

# Keep disabled until the first live acceptance run passes.
RESTART_POLICY=no

# Adopted 2026-08-31 (KV offload Phase A, arm A0): expandable_segments removed.
# Empty = default allocator; KV pool measured +3.6% vs expandable_segments:True.
# Also the boot prerequisite for any future --kv-transfer-config connector.
PYTORCH_CUDA_ALLOC_CONF=
