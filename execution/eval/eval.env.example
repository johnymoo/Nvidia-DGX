# Eval harness config (execution/eval/). Copy to execution/eval/.env.eval
# (gitignored via .env.*) and fill in for your environment, or export these
# directly. No hostnames, IPs, or usernames belong in this example file, in
# .env.eval, or in any tracked file in this package -- use whatever ssh
# config alias resolves for you.

# Base URL of the OpenAI-compatible vLLM service (no trailing slash).
EVAL_BASE_URL=http://<host>:<port>
EVAL_MODEL=<served-model-name>

# Optional: defaults to EVAL_BASE_URL + /metrics if unset.
EVAL_METRICS_URL=

# Optional: ssh config aliases (from ~/.ssh/config) for head/worker
# MemAvailable sampling during a suite.py run. Leave both unset to disable
# that sampling entirely (or pass suite.py --no-hosts).
EVAL_HEAD_SSH=
EVAL_WORKER_SSH=

# Container name, for manifest/display and loghealth.sh only (no default;
# loghealth.sh refuses to run without it).
EVAL_CONTAINER=<container>

# Optional: path to the real menu photo used by block V. Not committed to
# this repo; offline runs and the test suite fall back to a synthetic
# placeholder image when this is unset.
EVAL_MENU_IMAGE=
