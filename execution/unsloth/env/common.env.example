# llama.cpp PR 26500 head, which includes the recommended b10269 DSpark fix.
UNSLOTH_LLAMA_IMAGE=gb10-unsloth-llama:f0c483c4-rpc
RDMA_HCA=rocep1s0f0

# Snapshot and exact Q4 + Q8 DSpark files are pinned by download-model.sh.
GGUF_MODEL_ROOT=/home/chriswang/model/DeepSeek-V4-Flash-0731-GGUF
GGUF_TARGET_MODEL=/models/UD-Q4_K_XL/DeepSeek-V4-Flash-0731-UD-Q4_K_XL-00001-of-00005.gguf
GGUF_DRAFT_MODEL=/models/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf

# Two RPC CUDA devices. The worker endpoint must remain fabric-only because the
# RPC protocol is explicitly insecure.
RPC_ENDPOINTS=127.0.0.1:50053,192.168.192.198:50052
TENSOR_SPLIT=1,1

# Start with the community-proven Q4 target profile at 256K, single stream.
# Switch to the dspark profile only after target-only parity is recorded.
CONTEXT_SIZE=262144
PARALLEL=1
SPEC_DRAFT_N_MAX=3

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8891
RESTART_POLICY=no
GGML_RPC_DEBUG=0
